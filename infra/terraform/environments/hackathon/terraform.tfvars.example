# Example variable definitions for hackathon environment
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars containing real email addresses or secrets.

aws_region  = "us-east-1"
environment = "hackathon"
project     = "kinetiq-v"

# Networking & Cost Optimization
single_nat_gateway = true # Save ~$32/mo by using 1 NAT Gateway across subnets
use_fargate_spot   = true # Save ~70% on ECS compute costs using Spot

# Budget & Spend Alerting
budget_limit_amount        = "50.0" # Monthly USD limit
budget_notification_emails = ["developer@example.com"]

# GitHub Actions OIDC Configuration
github_repository       = "Riippex/kinetiq-v"
github_oidc_environment = "hackathon" # Must match the GitHub Environment protecting the deploy workflow's job
create_oidc_provider    = true        # Set false if https://token.actions.githubusercontent.com already exists in your AWS account

# REQUIRED: numeric GitHub IDs for the environment-scoped immutable OIDC
# subject (repo:<owner>@<owner-id>/<repo>@<repo-id>:environment:<environment>).
# The placeholders below are obviously fake -- replace with the real values
# before applying, retrieved with (see docs/runbooks/infrastructure-bootstrap.md,
# "GitHub OIDC immutable subject", for the full verification procedure):
#   gh api repos/<owner>/<repo> --jq .id
#   gh api users/<owner> --jq .id   (user-owned repository)
#   gh api orgs/<owner> --jq .id    (organization-owned repository)
# These are numeric IDs, not secrets -- safe to commit to a real
# (non-example) terraform.tfvars if you choose to, same as github_repository.
github_repository_id       = "000000000"
github_repository_owner_id = "111111111"

# Custom Domain / TLS (REQUIRED -- there is no HTTP-only mode)
# Requires an EXISTING public Route53 hosted zone for the domain in this account.
# Terraform requests and DNS-validates a certificate for it, and every deployed
# origin (Cognito callbacks/logout, S3 CORS, Django allowed hosts, GraphQL/MCP
# URLs) is derived from it over HTTPS -- see docs/runbooks/infrastructure-bootstrap.md
# and infra/terraform/modules/compute/variables.tf.
domain_name = "hackathon.kinetiq.example"
#
# Alternative: bring your own already-issued certificate instead of Terraform
# provisioning one (takes precedence over domain_name-driven issuance; domain_name
# must still be set to the exact hostname the certificate was issued for, and an
# external DNS record must point that hostname at the ALB's DNS name):
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abc-123"
