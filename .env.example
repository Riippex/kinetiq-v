POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgresql://kinetiq:kinetiq@127.0.0.1:5432/kinetiq
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
VISION_BASE_URL=http://127.0.0.1:8001
VISION_TIMEOUT_SECONDS=5.0
VISION_SERVICE_CREDENTIAL=
AWS_PROFILE=default
AWS_REGION=us-east-1
# MLflow ARN and Cognito configuration are supplied after provisioning.

# MCP (Alexa+) endpoint: signed OIDC access tokens only. With no issuer or
# audience configured the endpoint rejects every token.
MCP_OIDC_ISSUER=
MCP_OIDC_AUDIENCE=
MCP_OIDC_JWKS_URL=
MCP_OIDC_REQUIRED_SCOPE=kinetiq/coach
MCP_OIDC_TOKEN_USE=access
MCP_RESOURCE_URL=http://localhost:8000/mcp
# DNS-rebinding protection. Hosts default to DJANGO_ALLOWED_HOSTS; origins are
# rejected unless listed (Alexa server-to-server calls send no Origin).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
