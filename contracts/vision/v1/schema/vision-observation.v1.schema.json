{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetiq.ai/schemas/vision/v1/observation.json",
  "title": "VisionObservationV1",
  "description": "Timestamped movement, tracking, and repetition observation event from the Vision service",
  "type": "object",
  "required": [
    "session_id",
    "epoch",
    "timestamp_utc",
    "target_person_id",
    "exercise_key",
    "exercise_version",
    "tracking_state",
    "visibility_state",
    "reason_code"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target_person_id": {
      "type": "string",
      "minLength": 1
    },
    "exercise_key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "exercise_version": {
      "type": "integer",
      "minimum": 1
    },
    "tracking_state": {
      "type": "string",
      "enum": ["CONFIRMED", "SEARCHING", "AMBIGUOUS", "LOST"]
    },
    "visibility_state": {
      "type": "string",
      "enum": ["FULL", "PARTIAL", "OCCLUDED", "ABSENT"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "OK",
        "TARGET_AMBIGUOUS",
        "OCCLUSION",
        "OUT_OF_FRAME",
        "LOW_CONFIDENCE"
      ]
    },
    "repetitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repetition_index",
          "start_timestamp",
          "end_timestamp",
          "confidence",
          "quality_score"
        ],
        "properties": {
          "repetition_index": {
            "type": "integer",
            "minimum": 1
          },
          "start_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "end_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "quality_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "form_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hold": {
      "type": "object",
      "required": [
        "elapsed_seconds",
        "is_holding",
        "confidence",
        "stability_score"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0.0
        },
        "is_holding": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "stability_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "form_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
