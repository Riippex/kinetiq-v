{
  "name": "kinetiq-v",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": { "node": ">=24.0.0 <25" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=@kinetiq/web",
    "dev:mobile": "npm run start --workspace=@kinetiq/mobile",
    "android": "npm run android --workspace=@kinetiq/mobile",
    "build:web": "npm run build --workspace=@kinetiq/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
